# ---------- 敏感配置（含飞书密钥 / 可道云账号密码，严禁提交） ----------
config.yaml
# Web 控制台保存配置时自动生成的备份文件（同样含密钥）
config.yaml.bak
config.yaml.bak.*
# 环境变量文件
.env
.env.*

# ---------- 运行日志 ----------
logs/*
!logs/.gitkeep
*.log

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
# 虚拟环境
venv/
.venv/
env/
# 测试 / 覆盖率（项目使用 pytest）
.pytest_cache/
.coverage
htmlcov/
# 静态检查缓存
.mypy_cache/
.ruff_cache/
# 打包产物
*.egg-info/
dist/
build/

# ---------- 构建产物（防御性忽略，避免 APK 误入仓库） ----------
*.apk
*.aab

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
